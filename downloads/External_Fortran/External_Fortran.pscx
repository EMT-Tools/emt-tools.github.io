      <script>
        <segment name="Fortran" id="656979575" classid="CoreSegment"><![CDATA[! EMT-Tools.com
! This example shows how to set up an external Fortran script, pass variables from PSCAD to the external script, and pass variables back to PSCAD.

! NOTE: This subroutine is called every timestep. To prevent that use logic block, or FIRSTSTEP, TIMEZERO etc.


      call mySub($MyReal, $MyInt, "$Name", $MyRealOut)]]></segment>
        <segment classid="CoreSegment" id="296385550" name="Help"><![CDATA[help.html]]></segment>
      </script>
